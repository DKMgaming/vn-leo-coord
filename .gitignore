# môi trường & cache Python
.venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# output chạy thử
out/
*.db
out/*.html

# Tệp tạm hệ thống và Office lock
~$*
.DS_Store
.idea/
.vscode/

# Tệp hồ sơ do người dùng tải lên
data/uploads/filings/*.json
!data/uploads/filings/.gitkeep
data/uploads/srs/*
!data/uploads/srs/.gitkeep

# Biến môi trường bảo mật
.env
.env.local
.env.*.local



